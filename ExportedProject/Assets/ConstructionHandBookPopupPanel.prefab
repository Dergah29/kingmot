    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.1
  m_Text: "1、将兵营升级为火晶建筑，可解锁对应兵种的火晶部队。\n\n2、部队的火晶等级与其所属的兵营火晶等级一致。\n\n3、随着火晶等级提升，兵种的基础属性也会随之提高。\n\n4、部队达到一定火晶等级，还能解锁相应兵种的新技能；后续提升至特定火晶等级，将强化技能的效果。\n\n5、部队升级至更高火晶等级，训练耗费的资源和时间均不变。"
  m_PointerTween: 0
  m_TweenScale: {x: 1.2, y: 1.2}
  m_isMaxWidth: 0
  m_maxWidth: 0

--- !u!114 &114105912343260855
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1291844617409189}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4b92691faec7c95e2b99a1e9aebad607, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  m_Material: {fileID: 0}
  m_Color: {r: 0.32941177, g: 0.22745098, b: 0.21176471, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: cc6284d09f458b845b1fde322281907e, type: 3}
    m_FontSize: 22
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.1
  m_Text: "1、大熔炉达到30级后，还可以升级为更高等的火晶建筑。部分建筑提升火晶等级时，需要消耗火晶道具。建筑火晶等级越高，需要消耗的火晶道具越多。\n\n2、当前能够通过火晶进而提升的建筑包括：大熔炉、士兵训练建筑、军医所、大使馆及指挥部。\n\n3、不同火晶建筑，通过升级获得的增益也有所不同。比如大熔炉的火晶等级提升后，外观将会改变；兵营火晶等级提升，可获得训练容量、训练速度和部队基础属性等方面的提升，具体效果可查看各建筑的详情。\n\n4、升级建筑的火晶等级，需要历经5个子阶段，全部子阶段升级都完成后，建筑的火晶等级才会提升1级。子阶段的升级，同样会带来提升，具体效果可在建筑升级界面中查看详情。"
  m_PointerTween: 0
  m_TweenScale: {x: 1.2, y: 1.2}
  m_isMaxWidth: 0
  m_maxWidth: 0
  colorType: 0
  m_isStatic: 1

--- !u!114 &114533803739292891
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1632457200066912}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4b92691faec7c95e2b99a1e9aebad607, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  m_Material: {fileID: 0}
  m_Color: {r: 0.32941177, g: 0.22745098, b: 0.21176471, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: cc6284d09f458b845b1fde322281907e, type: 3}
    m_FontSize: 22
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "1.【跨王国决战王城】：<color=#bf6c12>【备战】阶段</color>获得<color=#bf6c12>更高积分</color>的王国，将进攻另一方的太阳城，攻方的太阳城则处于被保护状态，不会被攻击。\n2.【战争】阶段，双方领主可<color=#bf6c12>跨王国</color>进入对手的疆域内与对方王国的领主战斗，双方大熔炉等级差值不大于<color=#bf6c12>3级</color>的前提下，可在击杀敌军或己方士兵损伤时获得积分（注：集结时，取队长的大熔炉等级；有援军参战时，则取被援助者的大熔炉等级）。\n3.如攻方获胜，占领太阳城的联盟盟主可将自己或盟友任命为两个王国共同的<color=#bf6c12>【至高执政官】</color>，战败方本轮的执政官将空缺。\n4.【跨王国决战王城】中，参与太阳城及炮台的战斗，可获得更多积分。"
  m_PointerTween: 0
  m_TweenScale: {x: 1.2, y: 1.2}
  m_isMaxWidth: 0
  m_maxWidth: 0
  colorType: 0
  m_isStatic: 1

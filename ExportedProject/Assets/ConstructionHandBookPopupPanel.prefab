--- !u!114 &114429401810989285
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1089843903986396}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4b92691faec7c95e2b99a1e9aebad607, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  m_Material: {fileID: 0}
  m_Color: {r: 0.32941177, g: 0.22745098, b: 0.21176471, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: cc6284d09f458b845b1fde322281907e, type: 3}
    m_FontSize: 22
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.1
  m_Text: "1、占领太阳城之后，执政官发现了太阳城的秘密，唤醒了克图格亚之心的力量。当这颗“心”重新跳动，消失已久的火晶核心再次出现。火晶——有生命的神秘晶体——既是强有力的能源，也能够强化人的心智；它将成为领主们征服冰原的关键！\n\n2、当大熔炉达到30级，且领主拥有满足要求的火晶核心，即可将包括大熔炉在内的部分建筑提升成为火晶建筑。\n\n3、城镇里的的兵营建筑也能成为更加强大的火晶兵营，领主麾下的士兵们将成为拥有更强实力的火晶部队。"
  m_PointerTween: 0
  m_TweenScale: {x: 1.2, y: 1.2}
  m_isMaxWidth: 0
  m_maxWidth: 0
  colorType: 0
  m_isStatic: 1
  m_key: builddes_ui_187
  supportHyperLink: 0

--- !u!114 &114095919050787622
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1167524263268962}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4b92691faec7c95e2b99a1e9aebad607, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  m_Material: {fileID: 0}
  m_Color: {r: 0.32941177, g: 0.22745098, b: 0.21176471, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: cc6284d09f458b845b1fde322281907e, type: 3}
    m_FontSize: 22
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "<color=#2c9df4>Soldiers cannot die</color> in [Swordland Showdown] and will <color=#2c9df4>auto-heal</color> at the end of the battle.\n\nTwo alliances will be matched against each other and shall enter the field and fight for dominance once the battle begins. Alliances to <color=#2c9df4>take control of a building for the first time</color> (i.e. once the building's color changes to the alliance's color) or maintains <color=#2c9df4>constant control over a building</color> will earn both <color=#2c9df4>Alliance and Personal [Relic Points]</color>. The battle will be declared ended once the timer reaches nil. Whichever alliance can lay claim to the most <color=#2c9df4>[Alliance Relic Points]</color> will be declared the winner. Plenty of rewards will be distributed at the end of the battle based on the alliance's <color=#2c9df4>Overall Performance</color> and the Governors' <color=#2c9df4>Personal Performance</color>.\nAlliance tiers and rewards are distributed based on the outcome of their [Legion 1] battle."
  m_PointerTween: 0
  m_TweenScale: {x: 1.2, y: 1.2}
  m_isMaxWidth: 0
  m_maxWidth: 0
  colorType: 0
  m_isStatic: 1

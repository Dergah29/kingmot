    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.1
  m_Text: "移民需要消耗移民授权书，消耗数量由领主的移民评分决定。\n移民评分（相较范围内的王国的标准值）越高，消耗的授权书越多。\n移民评分是对领主战斗实力水准的量化评分，根据领主的大熔炉等级、领主装备及宝石、英雄实力、英雄装备实力、宠物实力计算得出。"
  m_PointerTween: 0
  m_TweenScale: {x: 1.2, y: 1.2}

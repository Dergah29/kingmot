  m_FontData:
    m_Font: {fileID: 12800000, guid: cc6284d09f458b845b1fde322281907e, type: 3}
    m_FontSize: 22
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "战地急救阶段规则说明：\n1.<color=#bf6c12>【战争】阶段</color>阵亡的士兵可被复活，<color=#bf6c12>基础复活比例为30%</color>，<color=#bf6c12>最高可提升至90%</color>。\n2.消耗钻石可购买用于提升复活比例的【复活药剂】，每份可提高1%，<color=#bf6c12>通过消耗复活药剂最多可提升10%的复活比例</color>。\n3.盟友的援助也可提高复活比例，但援助方每次需要消耗一份【重生秘典】。每位领主都拥有<color=#bf6c12>20份</color>，每份可为盟友提高1%的复活比例，每个领主最多可以被盟友援助<color=#bf6c12>50次</color>。\n4.复活人数将基于【战争】阶段<color=#bf6c12>战报</color>中的阵亡人数（募兵所内士兵除外）而定。"
  m_PointerTween: 0
  m_TweenScale: {x: 1.2, y: 1.2}
  m_isMaxWidth: 0
  m_maxWidth: 0
  colorType: 0
  m_isStatic: 1

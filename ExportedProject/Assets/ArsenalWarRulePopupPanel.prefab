  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4b92691faec7c95e2b99a1e9aebad607, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  m_Material: {fileID: 0}
  m_Color: {r: 0.32941177, g: 0.22745098, b: 0.21176471, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: cc6284d09f458b845b1fde322281907e, type: 3}
    m_FontSize: 22
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "  Occupy or control buildings during the [Swordland Showdown] to earn Alliance and Personal [Relic Points], as well as a variety of buffs depending on the building controlled.\n  Each Squad of <color=#f43b3b>10,000</color> Total Soldier Power defeated during defenses will earn <color=#2c9df4>40</color> [Personal Relic Points], but no [Alliance Relic Points]. Each Squad of <color=#f43b3b>10,000</color> Total Soldier Power defeated during offenses will earn <color=#2c9df4>80</color> [Personal Relic Points], but no [Alliance Relic Points] either.\n  Combatants will receive <color=#2c9df4>1</color> free [Advanced Teleporter] at the start of the battle. Governors can recover used Advanced Teleporter for free once used after the cooldown period has elapsed. [Advanced Teleporter] will be available for combatants wishing to teleport.\n  Soldiers on the field cannot die directly, but will enter an Infirmary instead. Infirmary Capacity will be unlimited and shall treat all Injured within for free. Moreover, all Injured in the Infirmary will immediately recover upon leaving the field.\n  Towns will burn much more quickly on the field. If a Town's defenders are overpowered, and the flames are not extinguished very quickly, then the Town will be forcibly relocated to a safe zone.\n  Governors forced to leave mid-battle will only be able to rejoin after a <color=#f43b3b>12-minute</color> cooldown has elapsed.\n  All Tech, VIP, Governor Gear and Skin Bonus effects will remain active during battle."
  m_PointerTween: 0
  m_TweenScale: {x: 1.2, y: 1.2}
  m_isMaxWidth: 0
  m_maxWidth: 0
